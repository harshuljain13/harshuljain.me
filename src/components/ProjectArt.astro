---
/**
 * Original generated cover art for project cards.
 * Each variant is hand-built geometry that echoes what the project does —
 * no stock imagery, no external requests, scales crisply at any size.
 */
interface Props {
  variant: 'stream' | 'graph' | 'latency' | 'gate' | 'wave';
  accent: string;
  id: string;
}
const { variant, accent, id } = Astro.props;

// Tailwind gradient utilities don't apply to SVG <stop> elements, so map the
// accent token to concrete colours.
const PALETTE: Record<string, [string, string]> = {
  'from-violet-500 to-fuchsia-500': ['#8B5CF6', '#D946EF'],
  'from-sky-500 to-cyan-400': ['#0EA5E9', '#22D3EE'],
  'from-emerald-500 to-teal-400': ['#10B981', '#2DD4BF'],
  'from-amber-400 to-orange-500': ['#FBBF24', '#F97316'],
  'from-rose-500 to-pink-500': ['#F43F5E', '#EC4899'],
  'from-indigo-500 to-blue-500': ['#6366F1', '#3B82F6'],
  'from-cyan-500 to-sky-400': ['#06B6D4', '#38BDF8'],
};
const [c1, c2] = PALETTE[accent] ?? ['#10B981', '#2DD4BF'];

// token-stream bars: prefill block then a decoding tail
const streamBars = [
  34, 46, 58, 52, 64, 44, 56, 38, 50, 60,
  42, 54, 36, 48, 62, 40, 52, 44, 58, 34,
];

// node-graph: deterministic positions + edges
const nodes = [
  { x: 28, y: 46 }, { x: 72, y: 26 }, { x: 74, y: 70 },
  { x: 120, y: 40 }, { x: 124, y: 86 }, { x: 168, y: 58 },
  { x: 206, y: 32 }, { x: 212, y: 82 },
];
const edges = [[0,1],[0,2],[1,3],[2,3],[2,4],[3,5],[4,5],[5,6],[5,7]];

// latency curve: p50 flat then a p99 knee
const latencyPath =
  'M4,96 C36,94 56,90 78,84 C102,77 118,70 136,58 C152,47 162,34 174,22 C184,12 194,8 206,6';
const latencyFill = `${latencyPath} L206,112 L4,112 Z`;

// waveform amplitudes
const waveBars = [
  12, 20, 34, 52, 38, 64, 46, 72, 54, 80,
  58, 86, 50, 70, 42, 60, 30, 44, 22, 32, 16, 24,
];
---

<svg viewBox="0 0 232 112" class="w-full h-full" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  <defs>
    <linearGradient id={`g-${id}`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color={c1} />
      <stop offset="100%" stop-color={c2} />
    </linearGradient>
    <linearGradient id={`fade-${id}`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color={c1} stop-opacity="0.42" />
      <stop offset="100%" stop-color={c1} stop-opacity="0" />
    </linearGradient>
    <pattern id={`grid-${id}`} width="16" height="16" patternUnits="userSpaceOnUse">
      <path d="M16 0H0V16" fill="none" stroke="currentColor" stroke-width="0.5" opacity="0.14" />
    </pattern>
  </defs>

  <rect width="232" height="112" fill={`url(#grid-${id})`} />

  {variant === 'stream' && (
    <g>
      {streamBars.map((h, i) => (
        <rect
          x={6 + i * 11.2} y={(112 - h) / 2} width="6" height={h} rx="3"
          fill={`url(#g-${id})`}
          opacity={i < 6 ? 0.95 : 0.9 - (i - 6) * 0.045}
        />
      ))}
      <line x1="72" y1="12" x2="72" y2="100" stroke="currentColor" stroke-width="0.8" stroke-dasharray="3 4" opacity="0.4" />
    </g>
  )}

  {variant === 'graph' && (
    <g>
      {edges.map(([a, b]) => (
        <line
          x1={nodes[a].x} y1={nodes[a].y} x2={nodes[b].x} y2={nodes[b].y}
          stroke={`url(#g-${id})`} stroke-width="1.4" opacity="0.6"
        />
      ))}
      {nodes.map((n, i) => (
        <g>
          <circle cx={n.x} cy={n.y} r={i === 5 ? 11 : 7} fill={`url(#g-${id})`} opacity="0.18" />
          <circle cx={n.x} cy={n.y} r={i === 5 ? 6.5 : 4.5} fill={`url(#g-${id})`} />
        </g>
      ))}
    </g>
  )}

  {variant === 'latency' && (
    <g>
      <path d={latencyFill} fill={`url(#fade-${id})`} />
      <path d={latencyPath} fill="none" stroke={`url(#g-${id})`} stroke-width="2.6" stroke-linecap="round" />
      <line x1="4" y1="78" x2="226" y2="78" stroke="currentColor" stroke-width="0.8" stroke-dasharray="4 5" opacity="0.35" />
      <circle cx="174" cy="22" r="4.5" fill={`url(#g-${id})`} />
      <circle cx="174" cy="22" r="10" fill="none" stroke={`url(#g-${id})`} stroke-width="1.2" opacity="0.5" />
    </g>
  )}

  {variant === 'gate' && (
    <g>
      {[0, 1, 2, 3, 4, 5].map(i => (
        <circle cx={14 + i * 7} cy={56 - 22 + i * 7.4} r="3.4" fill={`url(#g-${id})`} opacity={0.35 + i * 0.1} />
      ))}
      <rect x="104" y="18" width="7" height="76" rx="3.5" fill={`url(#g-${id})`} />
      <rect x="121" y="18" width="7" height="76" rx="3.5" fill={`url(#g-${id})`} opacity="0.45" />
      {[0, 1, 2].map(i => (
        <circle cx={156 + i * 22} cy={56} r="4.6" fill={`url(#g-${id})`} opacity={0.95 - i * 0.22} />
      ))}
      <path d="M58,56 L98,56" stroke={`url(#g-${id})`} stroke-width="1.6" stroke-dasharray="4 4" opacity="0.7" />
      <path d="M134,56 L150,56" stroke={`url(#g-${id})`} stroke-width="1.6" opacity="0.7" />
    </g>
  )}

  {variant === 'wave' && (
    <g>
      {waveBars.map((h, i) => (
        <rect
          x={6 + i * 10.2} y={(112 - h) / 2} width="5" height={h} rx="2.5"
          fill={`url(#g-${id})`} opacity={0.55 + (h / 86) * 0.45}
        />
      ))}
    </g>
  )}
</svg>
