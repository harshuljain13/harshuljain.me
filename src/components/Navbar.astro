---
import { elsewhere } from '../data/content';

const links = [
  { href: '/#about', label: 'About' },
  { href: '/#speaking', label: 'Speaking' },
  { href: '/#research', label: 'Research' },
  { href: '/#projects', label: 'Projects' },
  { href: '/#writing', label: 'Writing' },
];
---

<header class="sticky top-0 z-50 border-b border-line bg-bg/80 backdrop-blur-xl">
  <nav class="container-wide flex items-center justify-between h-16">
    <a href="/" class="font-semibold tracking-tightest">Harshul Jain</a>

    <div class="hidden md:flex items-center gap-7 text-sm text-muted">
      {links.map(l => (
        <a href={l.href} class="hover:text-fg transition-colors duration-200">{l.label}</a>
      ))}
      <details data-profiles class="relative">
        <summary class="list-none cursor-pointer select-none flex items-center gap-1 hover:text-fg transition-colors duration-200 [&::-webkit-details-marker]:hidden">
          Profiles
          <svg class="transition-transform duration-200" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
        </summary>
        <div class="absolute right-1/2 translate-x-1/2 top-full mt-4 w-[520px] rounded-xl border border-line bg-surface p-6 shadow-[0_24px_48px_-20px_rgb(var(--shadow)/var(--shadow-a))] grid grid-cols-2 gap-x-8 gap-y-5">
          {elsewhere.map(g => (
            <div>
              <p class="text-[10px] font-mono uppercase tracking-[0.18em] text-muted mb-2">{g.group}</p>
              <ul class="space-y-1.5">
                {g.links.map(l => (
                  <li><a href={l.href} target="_blank" rel="noopener" class="text-fg hover:text-accent transition-colors">{l.label}</a></li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </details>
    </div>

    <div class="flex items-center gap-2">
      <a href="/#connect" class="hidden sm:inline-flex btn-primary !px-4 !py-2">Get in touch</a>
      <button data-theme-toggle class="p-2 rounded-lg text-muted hover:text-fg transition-colors" aria-label="Toggle theme">
        <svg class="dark:hidden" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <svg class="hidden dark:inline" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
      </button>
      <button data-menu-toggle class="md:hidden p-2 text-muted" aria-label="Toggle menu" aria-expanded="false">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </nav>

  <div data-mobile-menu class="hidden md:hidden border-t border-line bg-bg">
    <div class="container-wide flex flex-col py-4 gap-3.5 text-sm text-muted">
      {links.map(l => (
        <a href={l.href} data-mobile-link class="hover:text-fg transition-colors">{l.label}</a>
      ))}
      <div class="border-t border-line pt-4 mt-1 grid grid-cols-2 gap-x-6 gap-y-4">
        {elsewhere.map(g => (
          <div>
            <p class="text-[10px] font-mono uppercase tracking-[0.18em] mb-2">{g.group}</p>
            <ul class="space-y-1.5">
              {g.links.map(l => (
                <li><a href={l.href} target="_blank" rel="noopener" class="text-fg hover:text-accent transition-colors">{l.label}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <a href="/#connect" data-mobile-link class="btn-primary justify-center mt-1">Get in touch</a>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    const toggle = document.querySelector('[data-menu-toggle]');
    const menu = document.querySelector('[data-mobile-menu]');
    if (!toggle || !menu) return;
    const close = () => {
      menu.classList.add('hidden');
      toggle.setAttribute('aria-expanded', 'false');
    };
    toggle.addEventListener('click', () => {
      const hidden = menu.classList.toggle('hidden');
      toggle.setAttribute('aria-expanded', String(!hidden));
    });
    document.querySelectorAll('[data-mobile-link]').forEach((a) => a.addEventListener('click', close));
  })();
  (function () {
    const d = document.querySelector('[data-profiles]');
    if (!d) return;
    document.addEventListener('click', (e) => { if (!d.contains(e.target)) d.open = false; });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') d.open = false; });
  })();
</script>
