---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import TalkGrid from '../components/TalkGrid.astro';
import Logo from '../components/Logo.astro';
import ProjectArt from '../components/ProjectArt.astro';
import { profile, talks, papers, projects, highlights, workAreas, impact, mentoring, reviewing } from '../data/content';
import { fetchPosts, formatDate } from '../lib/substack';

const posts = await fetchPosts(4);

const statusLabel: Record<string, string> = {
  published: 'Published',
  preprint: 'Pre-print',
};

const socials = [
  { label: 'GitHub', href: profile.links.github },
  { label: 'Scholar', href: profile.links.scholar },
  { label: 'alphaXiv', href: profile.links.alphaxiv },
  { label: 'OpenReview', href: profile.links.openreview },
  { label: 'Substack', href: profile.links.substack },
  { label: 'LinkedIn', href: profile.links.linkedin },
  { label: 'X', href: profile.links.x },
];
---

<BaseLayout>
  <Navbar />

  {/* ---------------- HERO ---------------- */}
  <section id="top" class="relative overflow-hidden border-b border-line">
    <div class="hero-glow"><div class="hero-grid"></div></div>

    <div class="container-wide relative z-10 py-20 md:py-28">
      <div class="grid md:grid-cols-[1.5fr_auto] gap-12 md:gap-16 items-center">
        <div>
          <p class="eyebrow mb-6 fade-up">{profile.role} &middot; New York</p>

          <h1 class="text-4xl sm:text-5xl md:text-[3.25rem] leading-[1.06] font-semibold tracking-tightest mb-6 fade-up">
            {profile.headline[0]}<br />{profile.headline[1]}
          </h1>

          <span class="rule mb-7"></span>

          <p class="text-[17px] text-muted leading-relaxed max-w-xl mb-9 fade-up">
            {profile.tagline}
          </p>

          <div class="flex flex-wrap items-center gap-3 mb-10 fade-up">
            <a href={profile.links.handbook} target="_blank" rel="noopener" class="btn-primary">
              LLM Inference Handbook
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
            <a href={profile.links.substack} target="_blank" rel="noopener" class="btn-ghost">Read the Substack</a>
            <a href={profile.links.resume} target="_blank" rel="noopener" class="btn-ghost">Résumé</a>
          </div>

          <div class="flex flex-wrap items-center gap-x-8 gap-y-3 mb-9 fade-up">
            {impact.map(i => (
              <span class="flex items-baseline gap-1.5">
                <span class="text-[20px] font-semibold text-accent tracking-tightest">{i.value}</span>
                <span class="text-[13px] text-muted">{i.label}</span>
              </span>
            ))}
          </div>

          <div class="flex flex-wrap gap-x-6 gap-y-2 text-[13px] fade-up">
            {socials.map(s => (
              <a href={s.href} target="_blank" rel="noopener" class="text-muted hover:text-accent transition-colors">
                {s.label}
              </a>
            ))}
          </div>
        </div>

        <div class="hidden md:block fade-up">
          <div class="relative w-52 h-52 rounded-2xl overflow-hidden border border-line">
            <img
              src="/img/headshot.jpg"
              alt="Harshul Jain"
              width="416" height="416"
              class="w-full h-full object-cover"
              loading="eager"
            />
            <div class="absolute inset-0 ring-1 ring-inset ring-accent/15 rounded-2xl"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ---------------- APPEARANCES ---------------- */}
  <section class="border-b border-line bg-surface/40 overflow-hidden">
    <div class="container-wide pt-10 pb-2">
      <p class="eyebrow mb-8">Selected appearances</p>
    </div>
    <div class="marquee pb-11">
      <div class="marquee-track">
        {[0, 1].map(() => (
          <div class="marquee-group">
            {talks.map(t => (
              <a
                href={`/talks/${t.slug}`}
                class={`marquee-item ${t.brandFg === 'dark' ? 'bg-white rounded-xl px-5 py-3' : ''}`}
                title={`${t.venue} — ${t.date}`}
              >
                <Logo src={t.logo} class="logo-xl" onLight={t.brandFg === 'dark'} />
              </a>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ---------------- HIGHLIGHTS ---------------- */}
  <section id="highlights" class="section">
    <p class="eyebrow fade-up"><span class="opacity-50">01</span> In the community</p>
    <h2 class="section-title fade-up">Beyond the day job</h2>
    <p class="section-sub fade-up">
      Conference talks, hackathon judging, peer review, and mentoring across the engineering and AI community.
    </p>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
      {highlights.map(h => (
        <div class="card fade-up !p-5">
          <p class="text-3xl font-semibold tracking-tightest text-accent mb-1.5" data-count={h.value}>{h.value}</p>
          <p class="text-[12px] text-muted leading-snug">{h.label}</p>
        </div>
      ))}
    </div>

    {/* where the mentoring happens */}
    <div class="mt-5 card fade-up flex flex-col sm:flex-row sm:items-center gap-6 sm:gap-10">
      <div class="sm:max-w-xs">
        <p class="text-[15px] font-semibold mb-1.5">1:1 mentoring</p>
        <p class="text-[13px] text-muted leading-relaxed">
          300+ engineers mentored on interviews, ML systems, and career direction — booked through these platforms.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-3 sm:ml-auto">
        {mentoring.map(m => (
          <a
            href={m.href}
            target="_blank"
            rel="noopener"
            class="bg-white rounded-xl px-5 py-3 flex items-center transition-transform duration-200 hover:-translate-y-0.5"
            title={`${m.name} — Harshul Jain`}
          >
            <Logo src={m.logo} class="logo-sm" onLight raw />
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* ---------------- ABOUT ---------------- */}
  <section id="about" class="section !pt-0">
    <div class="grid md:grid-cols-[auto_1fr] gap-12 md:gap-20">
      <div class="md:w-56 shrink-0 fade-up">
        <p class="eyebrow"><span class="opacity-50">02</span> About</p>
        <h2 class="section-title !mb-6">Open ML/AI infra</h2>
        <div class="flex flex-wrap gap-2">
          {workAreas.map(w => <span class="chip normal-case">{w}</span>)}
        </div>
      </div>
      <div class="max-w-2xl fade-up">
        <p class="text-[17px] leading-[1.6] text-fg mb-7 border-l-2 border-accent pl-5">
          {profile.belief}
        </p>
        <div class="text-[15px] leading-[1.75] text-muted space-y-5">
          {profile.bioLong.map(p => <p>{p}</p>)}
        </div>
      </div>
    </div>
  </section>

  {/* ---------------- SPEAKING ---------------- */}
  <section id="speaking" class="section border-y border-line bg-surface/40">
    <p class="eyebrow fade-up"><span class="opacity-50">03</span> Speaking &amp; teaching</p>
    <h2 class="section-title fade-up">Talks, workshops, lectures</h2>
    <p class="section-sub fade-up">Conference sessions and university guest lectures. Cards marked ▶ have a recording — open one to watch.</p>
    <TalkGrid talks={talks} />
  </section>

  {/* ---------------- RESEARCH ---------------- */}
  <section id="research" class="section !pt-0">
    <p class="eyebrow fade-up"><span class="opacity-50">04</span> Research</p>
    <h2 class="section-title fade-up">Papers &amp; pre-prints</h2>
    <p class="section-sub fade-up">
      Admission control for LLM serving, knowledge conflicts in RAG, agent recoverability, and model validation — mirrored from Google Scholar.
    </p>

    <div class="space-y-4">
      {papers.map(p => {
        const href = p.arxiv ?? p.doi;
        const Tag = href ? 'a' : 'div';
        return (
          <Tag
            href={href}
            target={href ? '_blank' : undefined}
            rel={href ? 'noopener' : undefined}
            class="card group block fade-up"
          >
            <div class="flex flex-wrap items-center gap-2 mb-3">
              <span class={p.status === 'published' ? 'chip chip-amber' : 'chip chip-accent'}>
                {statusLabel[p.status]}
              </span>
              <span class="text-[11px] font-mono text-muted">{p.venue} · {p.year}</span>
              {p.cites ? (
                <span class="chip ml-auto">{p.cites} citation{p.cites === 1 ? '' : 's'}</span>
              ) : null}
            </div>

            <h3 class="text-[17px] font-semibold leading-snug mb-2 group-hover:text-accent transition-colors">
              {p.title}
            </h3>
            <p class="text-[13px] text-muted mb-3">{p.authors}</p>
            <p class="text-sm text-muted leading-relaxed mb-4 max-w-3xl">{p.summary}</p>

            {href && (
              <span class="inline-flex items-center gap-1.5 text-[13px] font-medium text-accent">
                {p.arxiv ? 'arXiv' : 'DOI'}
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </span>
            )}
          </Tag>
        );
      })}
    </div>

    {/* peer review */}
    <div class="mt-14 fade-up">
      <h3 class="text-[17px] font-semibold mb-1.5">Peer review &amp; program committees</h3>
      <p class="text-[13px] text-muted mb-5">Reviewing for ML and trustworthy-AI venues.</p>
      <div class="grid md:grid-cols-3 gap-4">
        {reviewing.map(r => (
          <a href={r.href} target="_blank" rel="noopener" class="card group block !p-5">
            <span class="chip chip-accent mb-3">{r.role}</span>
            <p class="text-[15px] font-semibold leading-snug mb-1 group-hover:text-accent transition-colors">{r.venue}</p>
            <p class="text-[12px] text-muted leading-snug mb-2">{r.name}</p>
            <p class="text-[11px] font-mono text-muted mb-3">{r.when}</p>
            <p class="text-[13px] text-muted leading-relaxed">{r.note}</p>
          </a>
        ))}
      </div>
    </div>

    <div class="mt-8 flex flex-wrap gap-3 fade-up">
      <a href={profile.links.scholar} target="_blank" rel="noopener" class="btn-ghost">
        Full list on Google Scholar
      </a>
      <a href={profile.links.openreview} target="_blank" rel="noopener" class="btn-ghost">
        OpenReview profile
      </a>
    </div>
  </section>

  {/* ---------------- PROJECTS ---------------- */}
  <section id="projects" class="section border-y border-line bg-surface/40">
    <p class="eyebrow fade-up"><span class="opacity-50">05</span> Projects</p>
    <h2 class="section-title fade-up">Open source</h2>
    <p class="section-sub fade-up">Handbooks, runtimes, and benchmarks.</p>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
      {projects.map(proj => (
        <a href={proj.link ?? '#'} target={proj.link ? '_blank' : undefined} rel="noopener" class="card group block fade-up !p-0 overflow-hidden">
          <div class="project-art relative h-32 border-b border-line bg-elevated text-fg overflow-hidden">
            {proj.image ? (
              <img
                src={proj.image}
                alt={`${proj.name} banner`}
                loading="lazy"
                class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
              />
            ) : (
              <ProjectArt variant={proj.art} accent={proj.accent} id={proj.art} />
            )}
          </div>
          <div class="p-5">
            <div class="flex items-center justify-between mb-3">
              <span class="chip">{proj.tag}</span>
              <svg class="text-muted group-hover:text-accent transition-colors" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M7 7h10v10"/></svg>
            </div>
            <h3 class="text-[15px] font-semibold leading-snug mb-2 group-hover:text-accent transition-colors">{proj.name}</h3>
            <p class="text-[13px] text-muted leading-relaxed">{proj.tagline}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  {/* ---------------- WRITING ---------------- */}
  <section id="writing" class="section !pt-0">
    <div class="flex items-end justify-between gap-6 mb-12">
      <div class="fade-up">
        <p class="eyebrow"><span class="opacity-50">06</span> Writing</p>
        <h2 class="section-title !mb-3">Essays</h2>
        <p class="text-[15px] text-muted">On inference, agents, and engineering craft.</p>
      </div>
      <a href={profile.links.substack} target="_blank" rel="noopener" class="btn-ghost shrink-0 hidden sm:inline-flex fade-up">
        All on Substack
      </a>
    </div>

    {posts.length === 0 ? (
      <p class="text-sm text-muted fade-up">
        Essays mirror from Substack at build time.
        <a href={profile.links.substack} target="_blank" rel="noopener" class="text-accent"> Visit Substack</a>.
      </p>
    ) : (
      <div class="grid md:grid-cols-2 gap-4">
        {posts.map(post => (
          <a href={post.url} target="_blank" rel="noopener" class="card group block fade-up !p-0 overflow-hidden">
            <div class="relative aspect-[16/9] overflow-hidden border-b border-line bg-elevated">
              {post.image ? (
                <img
                  src={post.image}
                  alt={post.title}
                  loading="lazy"
                  class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.05]"
                />
              ) : (
                <div class="absolute inset-0 flex items-center justify-center">
                  <div class="absolute inset-0 opacity-[0.07]"
                       style="background-image:linear-gradient(rgb(var(--fg)) 1px,transparent 1px),linear-gradient(90deg,rgb(var(--fg)) 1px,transparent 1px);background-size:26px 26px"></div>
                  <span class="relative text-[13px] font-mono text-muted">Substack</span>
                </div>
              )}
              <div class="absolute inset-0 bg-gradient-to-t from-black/45 to-transparent"></div>
            </div>
            <div class="p-5">
              <p class="text-[11px] font-mono text-muted mb-2">{formatDate(post.date)}</p>
              <p class="text-[15px] font-semibold leading-snug group-hover:text-accent transition-colors">{post.title}</p>
              {post.dek && <p class="text-[13px] text-muted leading-relaxed mt-2 line-clamp-2">{post.dek}</p>}
            </div>
          </a>
        ))}
      </div>
    )}
  </section>

  {/* ---------------- CONNECT ---------------- */}
  <section id="connect" class="section !pt-0">
    <div class="relative overflow-hidden rounded-2xl border border-line bg-surface p-10 md:p-14 fade-up">
      <div class="absolute -top-24 -right-24 w-80 h-80 rounded-full pointer-events-none"
           style="background:radial-gradient(circle,rgb(var(--accent)/0.14),transparent 70%);filter:blur(30px)"></div>
      <div class="relative max-w-xl">
        <p class="eyebrow mb-5">Contact</p>
        <h2 class="text-2xl md:text-3xl font-semibold tracking-tightest mb-4">Let's talk</h2>
        <p class="text-[15px] text-muted leading-relaxed mb-8">
          Open to research collaborations, speaking invitations, mentoring, and conversations about LLM systems that ship.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href={`mailto:${profile.email}`} class="btn-primary">{profile.email}</a>
          <a href={profile.links.linkedin} target="_blank" rel="noopener" class="btn-ghost">LinkedIn</a>
        </div>
      </div>
    </div>
  </section>

  {/* ---------------- FOOTER ---------------- */}
  <footer class="border-t border-line">
    <div class="container-wide py-10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-5">
      <div>
        <p class="font-semibold tracking-tightest">Harshul Jain</p>
        <p class="text-[12px] font-mono text-muted mt-1">{profile.role} · New York</p>
      </div>
      <div class="flex flex-wrap gap-5 text-[13px]">
        {socials.map(s => (
          <a href={s.href} target="_blank" rel="noopener" class="text-muted hover:text-accent transition-colors">{s.label}</a>
        ))}
      </div>
      <p class="text-[12px] font-mono text-muted">© {new Date().getFullYear()}</p>
    </div>
  </footer>
</BaseLayout>
